# Copy to dashboard/.env for local development.
# Never put SUPABASE_SERVICE_ROLE_KEY here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional. Defaults to ${VITE_SUPABASE_URL}/functions/v1/record-simbox-event
# VITE_TRACKING_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/record-simbox-event
